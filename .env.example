# Runtime
VOICE_EVALS_ENV=development
VOICE_EVALS_DATABASE_URL=postgresql+psycopg://voice_evals:voice_evals@postgres:5432/voice_evals
VOICE_EVALS_REDIS_URL=redis://redis:6379/0
VOICE_EVALS_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:8000
VOICE_EVALS_CORS_ORIGINS=http://localhost:3000

# Bootstrap local administrator (change before exposing a deployment)
VOICE_EVALS_BOOTSTRAP_EMAIL=admin@example.com
VOICE_EVALS_BOOTSTRAP_PASSWORD=change-me-before-production

# Generate with: python3 -c 'import base64, os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())'
VOICE_EVALS_ENCRYPTION_KEY=

# Optional environment-only provider credentials
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Explicitly enable deterministic provider only for test/demo environments
VOICE_EVALS_ENABLE_TEST_PROVIDER=false

# Run-level cost/safety ceilings
VOICE_EVALS_MAX_CONVERSATIONS_PER_RUN=10000
VOICE_EVALS_MAX_EVALUATOR_CALLS_PER_RUN=50000
